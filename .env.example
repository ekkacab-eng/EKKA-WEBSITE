# Copy to .env and fill in from the Supabase dashboard:
#   Project Settings -> API
#
# Both values are safe in client code: the anon key is designed to be public,
# and Row Level Security (see supabase/waitlist.sql) is what actually protects
# the data. NEVER put the service_role key here — it bypasses RLS entirely.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
